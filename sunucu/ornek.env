# Örnek: /etc/birlikte/site.env (root:site, 640). Açıklamalar: sunucu/ORTAM.md
# Buradaki değerler yer tutucudur; gerçek değerleri bu dosyaya yazmayın.
PORT=3001
APP_ENV=production
DATABASE_URL=postgresql:///site?host=/var/run/postgresql
BIA_JWT_SECRET=<vercel-deki-BIA_JWT_SECRET-degeri>
BIA_ADMIN_PASSWORD=<yonetim-sifresi>
BIA_GITHUB_TOKEN=<contents-yazma-yetkili-github-tokeni>
# İsteğe bağlı:
# BIA_USERS=[{"id":"ornek","name":"Örnek Kullanıcı","password":"<sifre>","role":"admin"}]
# BIA_LISTE_PASSWORD=<en-az-12-karakter>
