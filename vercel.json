{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/yonetim/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}, {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "X-Frame-Options", "value": "SAMEORIGIN"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains"}, {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.tailwindcss.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://*.googleapis.com https://*.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto:"}, {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()"}]},
    {"source": "/css/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/js/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/images/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
  ],
  "redirects": [
    {"source": "/:path*", "has": [{"type": "host", "value": "www.birlikteiyilik.com"}], "destination": "https://birlikteiyilik.com/:path*", "permanent": true},
    {"source": "/iletisim", "destination": "/#iletisim", "permanent": true},
    {"source": "/uygulama", "destination": "/#uygulama", "permanent": true},
    {"source": "/yazilar", "destination": "/#icerik", "permanent": true},
    {"source": "/etki", "destination": "/#etki", "permanent": true}
  ]
}
